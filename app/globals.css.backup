@import "tailwindcss";

:root {
  --ink: #112b26;
  --ink-deep: #0a1d1a;
  --forest: #173f36;
  --forest-soft: #28574a;
  --sage: #dce6dc;
  --sand: #f6f4ef;
  --paper: #fbfaf7;
  --gold: #c7a878;
  --muted: #6d7771;
  --line: #dfe4de;
  --white: #fffefa;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
html, body { min-width: 320px; }
[id] { scroll-margin-top: 96px; }
body { margin: 0; background: var(--paper); color: var(--ink); font-family: Arial, Helvetica, sans-serif; }
body.modal-open { overflow: hidden; }
a { color: inherit; text-decoration: none; }
button, input, select, textarea { font: inherit; }
button { cursor: pointer; }
img { display: block; max-width: 100%; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }

.tenant-theme-shell {
  --ink: var(--theme-primary);
  --ink-deep: var(--theme-primary);
  --forest: var(--theme-primary);
  --forest-soft: var(--theme-primary);
  --sage: var(--theme-secondary);
  --sand: var(--theme-secondary);
  --paper: var(--theme-background);
  --gold: var(--theme-accent);
  --line: var(--theme-secondary);
  color: var(--theme-primary);
  font-family: var(--theme-font-family);
}
.tenant-theme-shell .button { border-radius: var(--theme-button-radius); }
.tenant-theme-shell .tour-card, .tenant-theme-shell .planner-panel, .tenant-theme-shell .itinerary-day { border: var(--theme-card-border); box-shadow: var(--theme-card-shadow); }
.tenant-theme-shell .section-tours, .tenant-theme-shell .section-planner, .tenant-theme-shell .section-process { background: var(--theme-section-surface); }
.tenant-theme-shell .section-destinations { background: var(--theme-secondary); }
.tenant-theme-shell .section-services, .tenant-theme-shell .planner-result { background: var(--theme-primary); }

.container { width: min(1180px, calc(100% - 80px)); margin: 0 auto; }
.site-header { position: fixed; z-index: 40; top: 0; width: 100%; color: var(--white); background: linear-gradient(180deg, rgba(7, 26, 22, .56), rgba(7, 26, 22, 0)); transition: color .25s ease, background .25s ease, box-shadow .25s ease, backdrop-filter .25s ease; }
.site-header-scrolled { color: var(--ink); background: rgba(251, 250, 247, .96); box-shadow: 0 8px 24px rgba(10, 29, 26, .08); backdrop-filter: blur(12px); }
.site-header-scrolled .brand-mark { border-color: var(--ink); }
.site-header-scrolled .brand-copy small { color: var(--muted); }
.site-header-scrolled .main-nav a, .site-header-scrolled .language-switch { color: var(--forest-soft); }
.site-header-scrolled .main-nav a:hover, .site-header-scrolled .language-switch:hover { color: var(--ink); }
.header-inner { width: min(1320px, calc(100% - 72px)); min-height: 86px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 32px; }
.brand { display: inline-flex; align-items: center; gap: 12px; flex-shrink: 0; }
.brand-mark { display: grid; width: 34px; height: 34px; place-items: center; border: 1px solid rgba(255,255,255,.7); border-radius: 50%; font-family: Georgia, serif; font-size: 18px; font-style: italic; }
.brand-copy { display: grid; gap: 2px; }
.brand-copy strong { font-size: 13px; font-weight: 600; letter-spacing: .07em; }
.brand-copy small { color: rgba(255,255,255,.66); font-size: 10px; letter-spacing: .18em; }
.nav-panel, .main-nav, .header-actions { display: flex; align-items: center; }
.nav-panel { gap: 38px; }
.main-nav { gap: 25px; }
.main-nav a, .language-switch { color: rgba(255,255,255,.84); font-size: 11px; letter-spacing: .08em; transition: color .2s ease; }
.main-nav a:hover, .language-switch:hover { color: var(--white); }
.header-actions { gap: 20px; }
.language-switch { padding: 0; border: 0; background: transparent; }
.language-divider { margin: 0 5px; color: rgba(255,255,255,.36); }
.language-muted { color: rgba(255,255,255,.46); }
.mobile-menu-button { display: none; }

.button { display: inline-flex; align-items: center; justify-content: center; gap: 20px; min-height: 50px; padding: 0 22px; border: 1px solid transparent; border-radius: 0; font-size: 11px; font-weight: 600; letter-spacing: .08em; transition: transform .2s ease, background .2s ease, color .2s ease, border-color .2s ease; }
.button:hover { transform: translateY(-2px); }
.button span { font-size: 17px; line-height: 1; }
.button-small { min-height: 38px; padding: 0 17px; font-size: 10px; }
.button-dark { background: var(--ink); color: var(--white); }
.button-dark:hover { background: var(--forest-soft); }
.button-light { background: var(--white); color: var(--ink); }
.button-light:hover { background: #f2e9d9; }
.button-ghost { border-color: rgba(255,255,255,.5); color: var(--white); background: transparent; }
.button-ghost:hover { border-color: var(--white); background: rgba(255,255,255,.08); }

.hero-section { position: relative; min-height: 770px; overflow: hidden; color: var(--white); background: var(--ink-deep); }
.hero-slides { position: absolute; z-index: 0; inset: 0; background: var(--ink-deep); }
.hero-empty-state { position: absolute; inset: 50% auto auto max(40px, calc((100% - 1180px) / 2)); margin: 0; transform: translateY(-50%); color: rgba(255,255,255,.6); font-size: 13px; }
.hero-slide { position: absolute; inset: 0; opacity: 0; transition: opacity .9s ease; }
.hero-slide-active { opacity: 1; }
.hero-slide img { width: 100%; height: 100%; object-fit: cover; object-position: var(--hero-desktop-position, center center); transform: scale(1.01); }
.hero-overlay { position: absolute; z-index: 1; inset: 0; background: linear-gradient(90deg, rgba(8, 28, 24, .86) 0%, rgba(9, 31, 27, .58) 41%, rgba(9, 31, 27, .06) 76%), linear-gradient(0deg, rgba(7, 24, 20, .6), transparent 35%); }
.hero-content { position: relative; z-index: 1; display: flex; flex-direction: column; justify-content: center; min-height: 770px; padding-top: 56px; }
.hero-kicker { display: flex; align-items: center; gap: 12px; margin: 0 0 25px; color: rgba(255,255,255,.7); font-size: 11px; letter-spacing: .13em; text-transform: uppercase; }
.hero-kicker span { width: 33px; height: 1px; background: var(--gold); }
.hero-content h1 { max-width: 780px; margin: 0; font-family: Georgia, "Times New Roman", serif; font-size: clamp(62px, 8.4vw, 122px); font-weight: 400; letter-spacing: -.06em; line-height: .9; }
.hero-content h1 em, .customize-copy h2 em { color: #e1c998; font-style: italic; }
.hero-description { max-width: 390px; margin: 34px 0 8px; color: rgba(255,255,255,.81); font-size: 15px; line-height: 1.7; }
.hero-chinese { margin: 0; color: rgba(255,255,255,.48); font-size: 12px; letter-spacing: .05em; }
.hero-actions { display: flex; gap: 10px; margin-top: 30px; }
.hero-scroll-hint { position: absolute; z-index: 1; bottom: 34px; left: max(40px, calc((100% - 1180px) / 2)); display: flex; align-items: center; gap: 12px; color: rgba(255,255,255,.62); font-size: 10px; letter-spacing: .15em; text-transform: uppercase; }
.hero-scroll-hint span { display: block; width: 40px; height: 1px; background: rgba(255,255,255,.62); }
.hero-carousel-controls { position: absolute; z-index: 3; right: max(40px, calc((100% - 1180px) / 2)); bottom: 72px; display: flex; align-items: center; gap: 10px; }
.hero-carousel-arrow { display: grid; width: 42px; height: 42px; place-items: center; padding: 0; border: 1px solid rgba(255,255,255,.45); color: var(--white); background: rgba(17,43,38,.48); font-size: 18px; transition: border-color .2s ease, background .2s ease, color .2s ease; }
.hero-carousel-arrow:hover { border-color: var(--gold); color: var(--gold); background: rgba(17,43,38,.75); }
.hero-carousel-dots { display: flex; align-items: center; gap: 7px; }
.hero-carousel-dot { width: 8px; height: 8px; padding: 0; border: 1px solid rgba(255,255,255,.72); border-radius: 50%; background: transparent; transition: width .2s ease, border-color .2s ease, background .2s ease; }
.hero-carousel-dot:hover { border-color: var(--gold); }
.hero-carousel-dot-active { width: 22px; border-color: var(--gold); border-radius: 5px; background: var(--gold); }

.section { padding: 128px 0; }
.section-row { display: flex; justify-content: space-between; gap: 60px; }
.section-row-start { align-items: flex-start; }
.section-heading { max-width: 585px; }
.eyebrow { display: inline-block; margin-bottom: 19px; color: var(--forest-soft); font-size: 10px; font-weight: 700; letter-spacing: .19em; text-transform: uppercase; }
.section-heading h2 { margin: 0; color: var(--ink); font-family: Georgia, "Times New Roman", serif; font-size: clamp(42px, 4.9vw, 70px); font-weight: 400; letter-spacing: -.05em; line-height: .98; }
.section-heading p { max-width: 500px; margin: 23px 0 0; color: var(--muted); font-size: 14px; line-height: 1.8; }
.text-link, .card-link { display: inline-flex; align-items: center; gap: 12px; padding: 0 0 8px; border: 0; border-bottom: 1px solid var(--gold); color: var(--ink); background: transparent; font-size: 11px; font-weight: 700; letter-spacing: .1em; transition: gap .2s ease, color .2s ease; }
.text-link:hover, .card-link:hover { gap: 17px; color: var(--forest-soft); }
.section-side-note { padding-top: 12px; color: var(--forest-soft); font-size: 11px; letter-spacing: .12em; line-height: 1.8; text-align: right; text-transform: uppercase; }
.section-side-note span { color: var(--muted); font-size: 9px; letter-spacing: .07em; }
.section-side-note-dark { color: rgba(255,255,255,.7); }
.section-side-note-dark span { color: rgba(255,255,255,.45); }

.section-tours { background: var(--paper); }
.tour-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px 18px; margin-top: 67px; }
.tour-card { min-width: 0; background: var(--white); }
.tour-image-wrap { position: relative; height: 247px; overflow: hidden; background: var(--sage); }
.tour-image { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
.tour-card:hover .tour-image { transform: scale(1.04); }
.tour-tag, .tour-number { position: absolute; top: 16px; font-size: 9px; letter-spacing: .14em; text-transform: uppercase; }
.tour-tag { left: 16px; padding: 7px 9px; color: var(--white); background: rgba(17,43,38,.72); }
.tour-number { right: 16px; color: rgba(255,255,255,.84); }
.tour-card-body { padding: 24px 24px 25px; }
.tour-meta { display: flex; align-items: center; gap: 9px; margin-bottom: 13px; color: var(--forest-soft); font-size: 9px; font-weight: 700; letter-spacing: .11em; text-transform: uppercase; }
.meta-dot { width: 3px; height: 3px; border-radius: 50%; background: var(--gold); }
.tour-card h3 { margin: 0; font-family: Georgia, "Times New Roman", serif; font-size: 26px; font-weight: 400; letter-spacing: -.03em; line-height: 1.05; }
.tour-card p { min-height: 45px; margin: 14px 0 26px; color: var(--muted); font-size: 12px; line-height: 1.65; }
.tour-card-footer { display: flex; align-items: flex-end; justify-content: space-between; gap: 15px; }
.tour-card-footer strong { font-family: Georgia, "Times New Roman", serif; font-size: 19px; font-weight: 400; }
.card-link { padding-bottom: 6px; font-size: 9px; }
.tour-price-note { margin: 24px 0 0; color: var(--muted); font-size: 11px; line-height: 1.7; }

.section-destinations { padding-top: 30px; background: var(--sand); }
.destination-grid { display: grid; grid-template-columns: repeat(4, 1fr); grid-template-rows: repeat(2, 245px); gap: 12px; margin-top: 68px; }
.destination-card { position: relative; overflow: hidden; padding: 0; border: 0; color: var(--white); background: var(--forest); font: inherit; text-align: left; }
.destination-card-large { grid-column: span 2; }
.destination-card img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
.destination-card:hover img { transform: scale(1.06); }
.destination-shade { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(7,25,22,.82), rgba(7,25,22,.02) 75%); }
.destination-copy { position: absolute; right: 24px; bottom: 22px; left: 24px; }
.destination-index { display: block; margin-bottom: 17px; color: var(--gold); font-size: 9px; letter-spacing: .15em; }
.destination-copy h3 { max-width: 240px; margin: 0; font-family: Georgia, "Times New Roman", serif; font-size: 25px; font-weight: 400; line-height: 1.05; }
.destination-copy p { margin: 8px 0 0; color: rgba(255,255,255,.62); font-size: 10px; line-height: 1.5; }
.destination-arrow { position: absolute; top: 20px; right: 21px; color: rgba(255,255,255,.86); font-size: 22px; }

.section-planner { background: var(--paper); }
.planner-loading, .planner-empty-state { margin-top: 46px; color: var(--muted); font-size: 13px; line-height: 1.8; }
.planner-load-state { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 46px; padding-top: 22px; border-top: 1px solid var(--line); }
.planner-load-state p { margin: 0; color: var(--muted); font-size: 13px; }
.planner-layout { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(220px, .65fr); gap: 70px; margin-top: 68px; }
.planner-panel { padding: 30px; background: var(--white); border: 1px solid var(--line); }
.planner-field-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; color: var(--ink); font-size: 12px; font-weight: 700; letter-spacing: .08em; }
.planner-field-heading small { color: var(--muted); font-size: 10px; font-weight: 400; }
.planner-place-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
.planner-place { display: flex; align-items: center; justify-content: space-between; min-height: 48px; padding: 0 15px; border: 1px solid var(--line); color: var(--ink); background: var(--paper); font-size: 12px; text-align: left; transition: border-color .2s ease, background .2s ease, color .2s ease; }
.planner-place:hover { border-color: var(--gold); }
.planner-place-selected { border-color: var(--forest); color: var(--white); background: var(--forest); }
.planner-place-selected span:last-child { color: var(--gold); }
.planner-controls { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px 12px; margin-top: 28px; }
.planner-controls label { display: grid; gap: 8px; color: var(--forest-soft); font-size: 10px; font-weight: 700; letter-spacing: .08em; }
.planner-controls select { width: 100%; min-height: 42px; padding: 0 12px; border: 1px solid var(--line); color: var(--ink); background: var(--paper); font-size: 12px; font-weight: 400; }
.planner-error { margin: 18px 0 0; color: #a14e42; font-size: 11px; }
.planner-actions { display: flex; align-items: center; gap: 22px; margin-top: 28px; }
.planner-clear { font-size: 10px; }
.planner-intro-note { align-self: end; padding: 24px 0 10px; border-top: 1px solid var(--line); }
.planner-note-mark { display: block; margin-bottom: 22px; color: var(--gold); font-size: 25px; }
.planner-intro-note p { margin: 0 0 16px; color: var(--muted); font-size: 12px; line-height: 1.8; }
.planner-intro-note p:last-child { margin-bottom: 0; font-size: 11px; }
.planner-result { margin-top: 62px; padding: 34px; color: var(--white); background: var(--forest); }
.planner-result-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 30px; }
.planner-result-heading .eyebrow { margin-bottom: 11px; color: var(--gold); }
.planner-result-heading h3 { margin: 0; font-family: Georgia, serif; font-size: 34px; font-weight: 400; }
.itinerary-days { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 32px; }
.itinerary-day { min-width: 0; min-height: 255px; padding: 18px; border: 1px solid rgba(255,255,255,.18); background: rgba(255,255,255,.04); }
.itinerary-day-top { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; color: var(--gold); font-size: 18px; font-family: Georgia, serif; }
.itinerary-day-top small { max-width: 110px; color: rgba(255,255,255,.52); font-family: Arial, Helvetica, sans-serif; font-size: 9px; line-height: 1.4; text-align: right; }
.itinerary-day h4 { min-height: 43px; margin: 28px 0 15px; color: var(--white); font-family: Georgia, serif; font-size: 18px; font-weight: 400; line-height: 1.15; }
.itinerary-day ul { display: grid; gap: 7px; margin: 0; padding: 0; list-style: none; }
.itinerary-day li { color: rgba(255,255,255,.86); font-size: 11px; line-height: 1.5; }
.itinerary-day li::before { content: "•"; margin-right: 7px; color: var(--gold); }
.itinerary-empty-day, .itinerary-note, .itinerary-overnight { color: rgba(255,255,255,.54); font-size: 10px; line-height: 1.6; }
.itinerary-overnight { margin: 20px 0 0; }
.itinerary-overnight strong { color: rgba(255,255,255,.78); font-weight: 400; }
.itinerary-note { margin: 9px 0 0; }
.planner-result-footer { display: grid; grid-template-columns: 1.4fr .6fr; gap: 35px; margin-top: 28px; padding-top: 22px; border-top: 1px solid rgba(255,255,255,.18); }
.planner-result-footer strong { color: var(--gold); font-size: 10px; letter-spacing: .12em; text-transform: uppercase; }
.planner-result-footer p, .planner-submit-note { margin: 9px 0 0; color: rgba(255,255,255,.62); font-size: 11px; line-height: 1.7; }
.planner-submit-note { margin-top: 24px; color: rgba(255,255,255,.46); }

.section-services { background: var(--forest); color: var(--white); }
.section-services .section-heading h2, .section-services .section-heading p { color: var(--white); }
.section-services .section-heading p { color: rgba(255,255,255,.62); }
.benefits-grid { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 68px; border-top: 1px solid rgba(255,255,255,.17); border-bottom: 1px solid rgba(255,255,255,.17); }
.benefit-card { min-height: 250px; padding: 25px 28px 27px 0; border-right: 1px solid rgba(255,255,255,.17); }
.benefit-card + .benefit-card { padding-left: 28px; }
.benefit-card:last-child { border-right: 0; }
.benefit-topline { display: flex; justify-content: space-between; color: rgba(255,255,255,.46); font-size: 10px; letter-spacing: .14em; }
.benefit-icon { color: var(--gold); font-size: 23px; line-height: 1; }
.benefit-card h3 { margin: 58px 0 12px; color: var(--white); font-family: Georgia, "Times New Roman", serif; font-size: 24px; font-weight: 400; }
.benefit-card p { margin: 0; color: rgba(255,255,255,.58); font-size: 12px; line-height: 1.7; }

.section-process { background: var(--paper); }
.process-grid { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 68px; }
.process-step { position: relative; padding-right: 33px; }
.process-step + .process-step { padding-left: 33px; }
.process-number { color: var(--gold); font-family: Georgia, serif; font-size: 18px; }
.process-line { position: relative; height: 1px; margin: 22px 0 26px; background: var(--line); }
.process-line span { position: absolute; top: -3px; left: 0; width: 7px; height: 7px; border: 1px solid var(--forest-soft); border-radius: 50%; background: var(--paper); }
.process-step h3 { margin: 0; font-family: Georgia, serif; font-size: 21px; font-weight: 400; }
.process-step p { margin: 8px 0 0; color: var(--muted); font-size: 11px; }
.process-arrow { position: absolute; top: 48px; right: 13px; color: var(--gold); font-size: 20px; }
.payment-note { display: flex; align-items: center; justify-content: space-between; gap: 25px; margin-top: 77px; padding: 25px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.payment-label { color: var(--forest-soft); font-size: 9px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
.payment-note strong { font-family: Georgia, serif; font-size: 22px; font-weight: 400; }
.payment-note p { margin: 5px 0 0; color: var(--muted); font-size: 11px; }
.payment-status { color: var(--muted); font-size: 10px; letter-spacing: .08em; }

.section-customize { overflow: hidden; color: var(--white); background: var(--ink); }
.customize-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 95px; align-items: center; }
.eyebrow-light { color: var(--gold); }
.customize-copy h2 { margin: 0; color: var(--white); font-family: Georgia, serif; font-size: clamp(42px, 4.7vw, 68px); font-weight: 400; letter-spacing: -.05em; line-height: .98; }
.customize-copy > p { max-width: 430px; margin: 27px 0 0; color: rgba(255,255,255,.64); font-size: 14px; line-height: 1.8; }
.customize-details { display: flex; flex-wrap: wrap; gap: 10px 26px; margin: 25px 0 31px; color: rgba(255,255,255,.82); font-size: 10px; letter-spacing: .11em; text-transform: uppercase; }
.customize-details span { display: inline-flex; align-items: center; gap: 9px; }
.customize-details span::before { content: ""; width: 4px; height: 4px; border-radius: 50%; background: var(--gold); }
.customize-image-wrap { position: relative; height: 520px; }
.customize-image-wrap img { width: 100%; height: 100%; object-fit: cover; }
.customize-image-wrap::after { position: absolute; inset: 0; content: ""; background: linear-gradient(0deg, rgba(7,26,22,.58), transparent 55%); }
.image-caption { position: absolute; z-index: 1; right: 26px; bottom: 25px; color: rgba(255,255,255,.82); font-size: 11px; letter-spacing: .1em; line-height: 1.7; text-align: right; text-transform: uppercase; }
.image-caption em { color: var(--gold); font-family: Georgia, serif; font-size: 15px; letter-spacing: .06em; text-transform: none; }

.modal-backdrop { position: fixed; z-index: 100; inset: 0; display: grid; place-items: center; padding: 30px; background: rgba(6, 25, 21, .72); backdrop-filter: blur(8px); }
.customize-modal { width: min(800px, 100%); max-height: min(760px, calc(100vh - 60px)); overflow: auto; padding: 40px; background: var(--paper); box-shadow: 0 25px 100px rgba(0,0,0,.24); }
.modal-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; padding-bottom: 26px; border-bottom: 1px solid var(--line); }
.modal-header h2 { margin: 0; color: var(--ink); font-family: Georgia, serif; font-size: 37px; font-weight: 400; letter-spacing: -.04em; }
.modal-description { max-width: 480px; margin: 12px 0 0; color: var(--muted); font-size: 12px; line-height: 1.65; }
.modal-close { width: 31px; height: 31px; border: 1px solid var(--line); color: var(--ink); background: transparent; font-size: 22px; line-height: 1; }
.customize-form { padding-top: 25px; }
.form-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
.form-grid label { display: grid; gap: 8px; color: var(--forest-soft); font-size: 10px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
.form-grid input, .form-grid select, .form-grid textarea { width: 100%; padding: 12px 13px; border: 1px solid var(--line); border-radius: 0; outline: none; color: var(--ink); background: var(--white); font-size: 12px; font-weight: 400; letter-spacing: 0; text-transform: none; transition: border-color .2s ease; }
.form-grid input:focus, .form-grid select:focus, .form-grid textarea:focus { border-color: var(--forest-soft); }
.form-grid textarea { resize: vertical; }
.form-full { grid-column: 1 / -1; }
.form-actions { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 25px; }
.form-actions p { max-width: 250px; margin: 0; color: var(--muted); font-size: 10px; line-height: 1.5; }
.form-error { color: #a13b31 !important; }
.privacy-consent { display: flex; align-items: flex-start; gap: 9px; margin-top: 22px; color: var(--muted); font-size: 11px; line-height: 1.6; }
.privacy-consent input { flex: 0 0 auto; width: 15px; height: 15px; margin: 2px 0 0; accent-color: var(--forest-soft); }
.privacy-consent a { color: var(--forest-soft); text-decoration: underline; text-underline-offset: 3px; }
.honeypot-field { position: absolute; width: 1px; height: 1px; overflow: hidden; opacity: .01; }
.honeypot-field input { position: absolute; left: -10000px; }
.button:disabled { cursor: wait; opacity: .6; transform: none; }
.success-state { padding: 65px 15px 45px; text-align: center; }
.success-mark { display: grid; width: 48px; height: 48px; margin: 0 auto 25px; place-items: center; border: 1px solid var(--gold); border-radius: 50%; color: var(--forest-soft); font-size: 22px; }
.success-state h3 { margin: 0; font-family: Georgia, serif; font-size: 30px; font-weight: 400; }
.success-state p { max-width: 420px; margin: 17px auto 28px; color: var(--muted); font-size: 13px; line-height: 1.7; }

.section-about { background: var(--sand); }
.about-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 105px; align-items: center; }
.about-image-wrap { position: relative; height: 570px; }
.about-image-wrap img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 42%; }
.about-stamp { position: absolute; right: -26px; bottom: 28px; display: grid; width: 102px; height: 102px; place-content: center; border: 1px solid rgba(255,255,255,.62); border-radius: 50%; color: var(--white); background: rgba(17,43,38,.76); font-family: Georgia, serif; font-size: 33px; font-style: italic; text-align: center; }
.about-stamp small { display: block; margin-top: 3px; font-family: Arial, sans-serif; font-size: 6px; font-style: normal; letter-spacing: .13em; }
.about-lead { margin: 33px 0 27px; color: var(--ink); font-family: Georgia, serif; font-size: 21px; line-height: 1.45; }
.about-services { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-bottom: 32px; }
.about-services span { padding: 11px 0; border-bottom: 1px solid var(--line); color: var(--muted); font-size: 11px; }

.section-faq { background: var(--sand); }
.faq-layout { display: grid; grid-template-columns: .85fr 1.15fr; gap: 100px; }
.faq-list { border-top: 1px solid var(--line); }
.faq-item { border-bottom: 1px solid var(--line); }
.faq-question { display: flex; align-items: center; justify-content: space-between; width: 100%; padding: 22px 0; border: 0; color: var(--ink); background: transparent; text-align: left; font-family: Georgia, serif; font-size: 20px; }
.faq-toggle { color: var(--gold); font-family: Arial, sans-serif; font-size: 24px; font-weight: 300; }
.faq-answer { max-width: 570px; margin: -6px 36px 22px 0; color: var(--muted); font-size: 12px; line-height: 1.75; }

.section-contact { background: var(--paper); }
.contact-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 120px; align-items: center; }
.contact-list { border-top: 1px solid var(--line); }
.contact-item { display: grid; grid-template-columns: 105px 1fr; gap: 15px; padding: 18px 0; border-bottom: 1px solid var(--line); }
.contact-item span { color: var(--forest-soft); font-size: 10px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
.contact-item strong { color: var(--ink); font-family: Georgia, serif; font-size: 18px; font-weight: 400; }
.contact-value { display: flex; align-items: center; flex-wrap: wrap; gap: 10px 14px; }
.contact-copy { padding: 5px 8px; border: 1px solid var(--line); color: var(--forest-soft); background: transparent; font-size: 9px; letter-spacing: .05em; }
.contact-copy:hover { border-color: var(--gold); color: var(--ink); }
.contact-item-address strong { font-family: Arial, Helvetica, sans-serif; font-size: 12px; line-height: 1.7; }
.contact-empty { max-width: 280px; padding: 22px 0; color: var(--muted); font-size: 13px; line-height: 1.7; }

.tenant-state-page { display: grid; min-height: 100vh; place-items: center; padding: 40px 20px; color: var(--ink); background: var(--paper); }
.tenant-state-card { width: min(560px, 100%); padding: 56px; border: 1px solid var(--line); background: var(--sand); text-align: center; }
.tenant-state-card h1 { margin: 18px 0; font-family: Georgia, "Times New Roman", serif; font-size: clamp(40px, 7vw, 72px); font-weight: 400; letter-spacing: -.05em; line-height: .98; }
.tenant-state-card p { margin: 0 auto 24px; max-width: 420px; color: var(--muted); line-height: 1.8; }
.tenant-state-card strong { display: block; margin-bottom: 24px; color: var(--forest-soft); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; }

.site-footer { color: rgba(255,255,255,.76); background: var(--ink-deep); }
.footer-top { display: flex; justify-content: space-between; gap: 80px; padding-top: 75px; padding-bottom: 72px; }
.brand-footer .brand-mark { border-color: rgba(255,255,255,.46); }
.footer-brand p { margin: 23px 0 0; color: rgba(255,255,255,.45); font-family: Georgia, serif; font-size: 19px; line-height: 1.45; }
.footer-links { display: grid; grid-template-columns: repeat(3, 135px); gap: 48px; }
.footer-links > div { display: grid; align-content: start; gap: 13px; }
.footer-label { margin-bottom: 8px; color: var(--gold); font-size: 9px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
.footer-links a { color: rgba(255,255,255,.58); font-size: 11px; transition: color .2s ease; }
.footer-links a:hover { color: var(--white); }
.footer-bottom { display: flex; justify-content: space-between; gap: 20px; padding: 18px 0 23px; border-top: 1px solid rgba(255,255,255,.14); color: rgba(255,255,255,.35); font-size: 9px; letter-spacing: .06em; }
.footer-bottom a:hover { color: var(--gold); }

.legal-page { min-height: 100vh; color: var(--ink); background: var(--paper); }
.legal-container { width: min(980px, calc(100% - 48px)); margin: 0 auto; }
.legal-header { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 92px; border-bottom: 1px solid var(--line); }
.legal-brand { color: var(--ink); }
.legal-brand .brand-mark { border-color: var(--ink); }
.legal-back-link { color: var(--forest-soft); font-size: 11px; letter-spacing: .08em; }
.legal-back-link:hover { color: var(--ink); }
.legal-document { padding: 85px 0 100px; }
.legal-eyebrow { margin: 0 0 18px; color: var(--forest-soft); font-size: 10px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
.legal-document h1 { margin: 0; font-family: Georgia, "Times New Roman", serif; font-size: clamp(42px, 6vw, 72px); font-weight: 400; letter-spacing: -.05em; line-height: 1; }
.legal-date { margin: 18px 0 0; color: var(--muted); font-size: 12px; }
.legal-intro { margin: 58px 0 0; padding: 26px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); color: var(--ink); font-size: 14px; line-height: 2; }
.legal-section { margin-top: 54px; }
.legal-section + .legal-section { margin-top: 48px; }
.legal-section h2, .legal-section h3 { margin: 0 0 18px; color: var(--ink); font-family: Georgia, "Times New Roman", serif; font-weight: 400; line-height: 1.25; }
.legal-section h2 { font-size: 28px; }
.legal-section h3 { margin-top: 30px; font-size: 21px; }
.legal-section p, .legal-section li { color: var(--muted); font-size: 13px; line-height: 1.95; }
.legal-section p { margin: 0 0 13px; }
.legal-section ul { display: grid; gap: 9px; margin: 0; padding-left: 22px; }
.legal-section li::marker { color: var(--gold); }
.legal-section-depth-3 { margin-top: 30px; padding-left: 22px; border-left: 1px solid var(--line); }
.legal-footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px 30px; padding: 20px 0 28px; border-top: 1px solid var(--line); color: var(--muted); font-size: 10px; letter-spacing: .05em; }
.legal-footer a:hover { color: var(--forest-soft); }

@media (max-width: 1050px) {
  .container { width: min(100% - 48px, 880px); }
  .header-inner { width: calc(100% - 48px); }
  .main-nav { gap: 14px; }
  .nav-panel { gap: 20px; }
  .tour-grid { gap: 25px 14px; }
  .customize-layout, .about-layout { gap: 50px; }
  .faq-layout { gap: 55px; }
}

@media (max-width: 760px) {
  .container { width: calc(100% - 40px); }
  .site-header { background: rgba(7, 26, 22, .86); }
  .site-header-scrolled { color: var(--white); background: rgba(7, 26, 22, .94); }
  .site-header-scrolled .brand-mark { border-color: rgba(255,255,255,.7); }
  .site-header-scrolled .brand-copy small { color: rgba(255,255,255,.66); }
  .site-header-scrolled .mobile-menu-button span { background: var(--white); }
  .header-inner { width: calc(100% - 40px); min-height: 72px; }
  .mobile-menu-button { display: grid; gap: 6px; width: 36px; height: 36px; place-content: center; padding: 0; border: 1px solid rgba(255,255,255,.3); background: transparent; }
  .mobile-menu-button span { display: block; width: 15px; height: 1px; background: var(--white); }
  .nav-panel { position: absolute; top: 72px; right: 20px; left: 20px; display: none; padding: 25px; background: var(--ink-deep); box-shadow: 0 18px 40px rgba(0,0,0,.2); }
  .nav-panel-open { display: grid; gap: 25px; }
  .main-nav, .header-actions { display: grid; align-items: start; }
  .main-nav { gap: 19px; }
  .header-actions { gap: 18px; padding-top: 21px; border-top: 1px solid rgba(255,255,255,.15); }
  .header-actions .button { width: 100%; }
  .hero-section, .hero-content { min-height: 720px; }
  .hero-slide img { object-position: var(--hero-mobile-position, center center); }
  .hero-empty-state { right: 20px; left: 20px; }
  .hero-content h1 { font-size: clamp(56px, 15vw, 92px); }
  .hero-description { max-width: 320px; font-size: 13px; }
  .hero-actions { flex-direction: column; align-items: flex-start; }
  .hero-scroll-hint { left: 20px; bottom: 24px; }
  .section { padding: 86px 0; }
  .section-row { display: grid; gap: 30px; }
  .section-side-note { padding-top: 0; text-align: left; }
  .tour-grid { grid-template-columns: 1fr; margin-top: 46px; }
  .tour-image-wrap { height: 235px; }
  .destination-grid { grid-template-columns: repeat(2, 1fr); grid-template-rows: repeat(3, 200px); margin-top: 46px; }
  .destination-card-large { grid-column: span 2; }
  .destination-copy { right: 16px; bottom: 16px; left: 16px; }
  .destination-copy h3 { font-size: 20px; }
  .destination-copy p { font-size: 9px; }
  .planner-layout { grid-template-columns: 1fr; gap: 42px; margin-top: 46px; }
  .planner-panel { padding: 22px; }
  .planner-place-grid { grid-template-columns: 1fr; }
  .planner-controls { grid-template-columns: 1fr; gap: 14px; }
  .planner-intro-note { padding-top: 0; }
  .planner-result { margin-top: 46px; padding: 22px; }
  .planner-result-heading { align-items: flex-start; flex-direction: column; }
  .planner-result-heading .button { width: 100%; }
  .itinerary-days { grid-template-columns: repeat(2, 1fr); }
  .planner-result-footer { grid-template-columns: 1fr; gap: 20px; }
  .benefits-grid { grid-template-columns: repeat(2, 1fr); }
  .benefit-card { min-height: 230px; padding: 22px 18px 24px 0; }
  .benefit-card + .benefit-card { padding-left: 18px; }
  .benefit-card:nth-child(2) { border-right: 0; }
  .benefit-card:nth-child(n+3) { border-top: 1px solid rgba(255,255,255,.17); }
  .process-grid { grid-template-columns: repeat(2, 1fr); gap: 40px 0; }
  .process-step:nth-child(3), .process-step:nth-child(4) { border-top: 1px solid var(--line); padding-top: 30px; }
  .process-step + .process-step { padding-left: 20px; }
  .process-step { padding-right: 20px; }
  .process-arrow { display: none; }
  .payment-note { align-items: flex-start; flex-direction: column; gap: 12px; margin-top: 56px; }
  .customize-layout, .about-layout, .faq-layout, .contact-layout { grid-template-columns: 1fr; gap: 50px; }
  .customize-image-wrap { height: 380px; order: -1; }
  .customize-copy h2 { font-size: 53px; }
  .customize-modal { padding: 25px 20px; }
  .modal-header h2 { font-size: 28px; }
  .form-grid { grid-template-columns: 1fr; }
  .form-full { grid-column: auto; }
  .form-actions { align-items: flex-start; flex-direction: column; }
  .about-image-wrap { height: 430px; }
  .about-image-wrap img { object-position: 50% 40%; }
  .about-stamp { right: 15px; bottom: 15px; }
  .hero-carousel-controls { right: 20px; bottom: 58px; gap: 8px; }
  .hero-carousel-arrow { width: 44px; height: 44px; }
  .faq-layout { gap: 40px; }
  .faq-question { font-size: 17px; }
  .contact-layout { gap: 45px; }
  .contact-item { grid-template-columns: 85px 1fr; }
  .legal-container { width: min(100% - 40px, 620px); }
  .legal-header { min-height: 78px; }
  .legal-document { padding: 58px 0 72px; }
  .legal-intro { margin-top: 42px; font-size: 13px; }
  .legal-section { margin-top: 42px; }
  .legal-section h2 { font-size: 24px; }
  .legal-section h3 { font-size: 19px; }
  .legal-section p, .legal-section li { font-size: 12px; }
  .legal-section-depth-3 { padding-left: 16px; }
  .footer-top { display: grid; gap: 50px; padding-top: 55px; padding-bottom: 52px; }
  .footer-links { grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .footer-bottom { align-items: flex-start; flex-direction: column; gap: 10px; }
}

@media (max-width: 400px) {
  .container, .header-inner { width: calc(100% - 28px); }
  .hero-carousel-controls { right: 14px; }
  .modal-backdrop { padding: 12px; }
  .customize-modal { max-height: calc(100vh - 24px); padding: 22px 16px; }
  .modal-header { gap: 12px; }
  .modal-header h2 { font-size: 25px; }
  .contact-item { grid-template-columns: 72px 1fr; gap: 10px; }
  .contact-item strong { overflow-wrap: anywhere; }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after { transition-duration: .01ms !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; }
}

.admin-page { min-height: 100vh; color: var(--ink); background: var(--sand); }
.admin-topbar { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 78px; padding: 0 max(24px, calc((100% - 1240px) / 2)); border-bottom: 1px solid var(--line); background: var(--paper); }
.admin-brand, .admin-topbar-actions, .admin-login-brand { display: flex; align-items: center; }
.admin-brand { gap: 12px; }
.admin-brand .brand-mark, .admin-login-brand .brand-mark { display: grid; width: 34px; height: 34px; place-items: center; border: 1px solid var(--ink); border-radius: 50%; font-family: Georgia, serif; font-size: 18px; font-style: italic; }
.admin-brand strong, .admin-login-brand strong { display: block; font-size: 12px; letter-spacing: .1em; }
.admin-brand small, .admin-login-brand small { display: block; margin-top: 3px; color: var(--muted); font-size: 10px; letter-spacing: .08em; }
.admin-topbar-actions { gap: 18px; }
.admin-topbar-link { color: var(--forest-soft); font-size: 11px; }
.admin-tenant-chip { padding: 7px 10px; border: 1px solid var(--line); color: var(--forest-soft); font-size: 10px; letter-spacing: .08em; }
.admin-logout { padding: 7px 0; border: 0; border-bottom: 1px solid var(--gold); color: var(--ink); background: transparent; font-size: 11px; }
.admin-shell { width: min(1180px, calc(100% - 48px)); margin: 0 auto; padding: 72px 0 90px; }
.admin-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 30px; }
.admin-heading-actions { display: flex; align-items: center; justify-content: flex-end; flex-wrap: wrap; gap: 10px; flex-shrink: 0; }
.admin-heading h1, .admin-login-card h1, .admin-error-card h1 { margin: 0; font-family: Georgia, "Times New Roman", serif; font-size: clamp(42px, 5vw, 70px); font-weight: 400; letter-spacing: -.06em; line-height: .98; }
.admin-heading p, .admin-login-card > p, .admin-error-card p { margin: 22px 0 0; color: var(--muted); font-size: 13px; line-height: 1.8; }
.admin-site-link { flex-shrink: 0; }
.admin-metrics { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; margin-top: 56px; }
.admin-metrics article { display: grid; gap: 16px; min-height: 132px; padding: 22px; border: 1px solid var(--line); background: var(--paper); }
.admin-metrics span { color: var(--forest-soft); font-size: 10px; letter-spacing: .1em; }
.admin-metrics strong { font-family: Georgia, serif; font-size: 38px; font-weight: 400; }
.admin-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin-top: 14px; }
.admin-card { padding: 29px; border: 1px solid var(--line); background: var(--paper); }
.admin-card-wide { grid-column: span 2; }
.admin-card-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding-bottom: 18px; border-bottom: 1px solid var(--line); }
.admin-card-heading-links { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; }
.admin-card-heading .eyebrow { margin: 0; }
.admin-card h2 { margin: 0; font-family: Georgia, serif; font-size: 27px; font-weight: 400; }
.admin-info-list { margin: 0; }
.admin-info-row { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 18px; padding: 14px 0; border-bottom: 1px solid var(--line); }
.admin-info-row:last-child { border-bottom: 0; }
.admin-info-row dt { color: var(--muted); font-size: 11px; }
.admin-info-row dd { margin: 0; overflow-wrap: anywhere; color: var(--ink); font-size: 12px; line-height: 1.6; }
.admin-description-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; }
.admin-description-grid p { margin: 22px 0 0; color: var(--muted); font-family: Georgia, serif; font-size: 16px; line-height: 1.75; }
.admin-readonly-note { margin: 24px 0 0; color: var(--muted); font-size: 11px; line-height: 1.7; }
.admin-inquiry-entry-card p { margin: 22px 0 0; color: var(--muted); font-size: 13px; line-height: 1.7; }
.admin-inquiry-list-card, .admin-inquiry-detail-card { margin-top: 34px; }
.admin-inquiry-total, .admin-inquiry-order { color: var(--muted); font-size: 11px; }
.admin-inquiry-toolbar { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; padding: 22px 0; border-bottom: 1px solid var(--line); }
.admin-inquiry-toolbar label, .admin-inquiry-status-editor label { display: grid; gap: 7px; color: var(--forest-soft); font-size: 11px; }
.admin-inquiry-toolbar select, .admin-inquiry-status-editor select { min-width: 170px; padding: 11px 13px; border: 1px solid var(--line); color: var(--ink); background: var(--white); }
.admin-inquiry-table-wrap { overflow-x: auto; }
.admin-inquiry-table { width: 100%; min-width: 900px; border-collapse: collapse; font-size: 12px; }
.admin-inquiry-table th { padding: 14px 10px; color: var(--muted); font-size: 9px; font-weight: 700; letter-spacing: .08em; text-align: left; white-space: nowrap; }
.admin-inquiry-table td { padding: 16px 10px; border-top: 1px solid var(--line); vertical-align: top; white-space: nowrap; }
.admin-inquiry-table td:nth-child(4) { white-space: normal; }
.admin-inquiry-empty { padding: 44px 10px !important; color: var(--muted); text-align: center; }
.admin-inquiry-status { display: inline-flex; padding: 5px 8px; color: var(--forest); background: var(--sage); font-size: 10px; white-space: nowrap; }
.admin-inquiry-status-contacted { background: #ece7d8; }
.admin-inquiry-status-following_up { background: #e5dfc5; }
.admin-inquiry-status-completed { background: #dce9dd; }
.admin-inquiry-status-closed { color: var(--muted); background: #e8e8e5; }
.admin-inquiry-pagination { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding-top: 22px; color: var(--muted); font-size: 11px; }
.admin-inquiry-pagination div { display: flex; gap: 8px; }
.admin-inquiry-detail-card { max-width: 900px; }
.admin-inquiry-detail-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 34px; margin: 0; }
.admin-inquiry-detail-row { display: grid; grid-template-columns: 100px minmax(0, 1fr); gap: 16px; padding: 17px 0; border-bottom: 1px solid var(--line); }
.admin-inquiry-detail-row dt { color: var(--muted); font-size: 11px; }
.admin-inquiry-detail-row dd { min-width: 0; margin: 0; overflow-wrap: anywhere; color: var(--ink); font-size: 13px; }
.admin-inquiry-message { min-height: 70px; white-space: pre-wrap; }
.admin-inquiry-status-editor { display: flex; align-items: flex-end; justify-content: space-between; gap: 18px; padding-top: 26px; }
.admin-inquiry-status-editor > span { color: var(--muted); font-size: 11px; }
.admin-login-page { display: grid; min-height: 100vh; place-items: center; padding: 32px 20px; color: var(--ink); background: var(--sand); }
.admin-login-card { width: min(460px, 100%); padding: 48px; border: 1px solid var(--line); background: var(--paper); box-shadow: 0 20px 60px rgba(17, 43, 38, .08); }
.admin-login-brand { gap: 12px; margin-bottom: 62px; }
.admin-login-card > .eyebrow { margin-bottom: 17px; }
.admin-login-form { display: grid; gap: 18px; margin-top: 34px; }
.admin-login-form label { display: grid; gap: 8px; color: var(--forest-soft); font-size: 10px; font-weight: 700; letter-spacing: .1em; }
.admin-login-form input { width: 100%; min-height: 46px; padding: 0 13px; border: 1px solid var(--line); color: var(--ink); background: var(--sand); outline: 0; }
.admin-login-form input:focus { border-color: var(--gold); }
.admin-submit { width: 100%; margin-top: 8px; }
.admin-submit:disabled { cursor: wait; opacity: .65; }
.admin-form-error { margin: 0; color: #9a4b3e; font-size: 12px; line-height: 1.6; }
.admin-back-link { display: block; margin-top: 28px; color: var(--forest-soft); font-size: 11px; text-align: center; }
.admin-back-link:hover { color: var(--ink); }
.admin-error-card { width: min(560px, calc(100% - 48px)); margin: 0 auto; padding: 52px; border: 1px solid var(--line); background: var(--paper); }
.admin-error-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 22px; margin-top: 28px; }
.admin-error-actions .button { margin-top: 0; }
.admin-logout-control { display: inline-flex; align-items: center; flex-wrap: wrap; gap: 12px; }
.admin-logout:disabled { cursor: wait; opacity: .6; }
.admin-action-error { color: #9a4b3e; font-size: 11px; line-height: 1.5; }
.admin-profile-shell { width: min(980px, calc(100% - 48px)); }
.admin-profile-card { margin-top: 44px; }
.admin-profile-form { display: grid; gap: 30px; }
.admin-profile-field-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 22px; }
.admin-profile-field { display: grid; align-content: start; gap: 9px; }
.admin-profile-field-wide { grid-column: span 2; }
.admin-profile-field label { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; color: var(--forest-soft); font-size: 11px; font-weight: 700; letter-spacing: .06em; }
.admin-profile-field label span { color: var(--muted); font-size: 10px; font-weight: 400; letter-spacing: 0; }
.admin-profile-field input, .admin-profile-field textarea { width: 100%; padding: 12px 13px; border: 1px solid var(--line); color: var(--ink); background: var(--sand); outline: 0; font: inherit; font-size: 13px; line-height: 1.7; }
.admin-profile-field input { min-height: 46px; }
.admin-profile-field textarea { min-height: 150px; resize: vertical; }
.admin-profile-field input:focus, .admin-profile-field textarea:focus { border-color: var(--gold); }
.admin-profile-field input:disabled, .admin-profile-field textarea:disabled { cursor: wait; opacity: .7; }
.admin-profile-field input[aria-invalid="true"], .admin-profile-field textarea[aria-invalid="true"] { border-color: #9a4b3e; }
.admin-field-error { margin: 0; color: #9a4b3e; font-size: 11px; line-height: 1.5; }
.admin-profile-actions { display: flex; flex-wrap: wrap; gap: 12px; padding-top: 8px; border-top: 1px solid var(--line); }
.admin-profile-actions .button { min-width: 120px; }
.admin-save-success { margin: 0; color: var(--forest-soft); font-size: 12px; }
.admin-profile-back-link { color: var(--forest-soft); font-size: 11px; }
.admin-profile-back-link:hover { color: var(--ink); }
.admin-images-shell { width: min(1180px, calc(100% - 48px)); }
.admin-images-section { margin-top: 14px; }
.admin-images-section:first-of-type { margin-top: 44px; }
.admin-image-count { color: var(--muted); font-size: 10px; letter-spacing: .08em; }
.admin-images-form { display: grid; gap: 28px; padding-top: 28px; }
.admin-image-card-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
.admin-image-card { display: grid; align-content: start; gap: 18px; padding: 18px; border: 1px solid var(--line); background: var(--sand); }
.admin-image-card-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
.admin-image-card-heading h3 { margin: 7px 0 0; font-family: Georgia, serif; font-size: 23px; font-weight: 400; }
.admin-image-card-label { max-width: 45%; color: var(--muted); font-size: 10px; line-height: 1.5; text-align: right; }
.admin-image-preview { position: relative; display: grid; min-height: 190px; place-items: center; overflow: hidden; background: var(--forest); }
.admin-image-preview img { display: block; width: 100%; height: 220px; object-fit: cover; }
.admin-image-preview-fallback { padding: 32px 20px; color: var(--paper); font-size: 12px; }
.admin-image-fields { display: grid; gap: 12px; }
.admin-image-fields label { display: grid; gap: 7px; color: var(--forest-soft); font-size: 10px; font-weight: 700; letter-spacing: .06em; }
.admin-image-fields input, .admin-image-fields select { width: 100%; min-height: 43px; padding: 9px 11px; border: 1px solid var(--line); color: var(--ink); background: var(--paper); outline: 0; font: inherit; font-size: 12px; }
.admin-image-fields input:focus, .admin-image-fields select:focus { border-color: var(--gold); }
.admin-image-fields input:disabled, .admin-image-fields select:disabled { cursor: wait; opacity: .7; }
.admin-image-fields input[aria-invalid="true"], .admin-image-fields select[aria-invalid="true"] { border-color: #9a4b3e; }
.admin-image-path { margin: -4px 0 0; overflow-wrap: anywhere; color: var(--muted); font-size: 10px; line-height: 1.5; }
.admin-contacts-shell { width: min(980px, calc(100% - 48px)); }
.admin-contacts-card { margin-top: 44px; }
.admin-contacts-form { display: grid; gap: 28px; padding-top: 28px; }
.admin-contact-loading { margin: 0; color: var(--muted); font-size: 12px; }
.admin-contact-list { display: grid; gap: 16px; }
.admin-contact-card { display: grid; gap: 22px; padding: 21px; border: 1px solid var(--line); background: var(--sand); }
.admin-contact-card-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; padding-bottom: 16px; border-bottom: 1px solid var(--line); }
.admin-contact-card-heading h3 { margin: 7px 0 0; font-family: Georgia, serif; font-size: 24px; font-weight: 400; }
.admin-contact-id { color: var(--muted); font-size: 10px; line-height: 1.5; }
.admin-contact-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 20px; }
.admin-contact-field { display: grid; align-content: start; gap: 7px; }
.admin-contact-field label { color: var(--forest-soft); font-size: 10px; font-weight: 700; letter-spacing: .06em; }
.admin-contact-field input, .admin-contact-field select, .admin-contact-readonly { width: 100%; min-height: 43px; padding: 9px 11px; border: 1px solid var(--line); color: var(--ink); background: var(--paper); outline: 0; font: inherit; font-size: 12px; }
.admin-contact-readonly { display: flex; align-items: center; color: var(--muted); background: var(--sand); }
.admin-contact-field input:focus, .admin-contact-field select:focus { border-color: var(--gold); }
.admin-contact-field input:disabled, .admin-contact-field select:disabled { cursor: wait; opacity: .7; }
.admin-contact-field input[aria-invalid="true"], .admin-contact-field select[aria-invalid="true"] { border-color: #9a4b3e; }
.admin-contact-field:nth-child(5) { grid-column: span 2; }
.admin-tours-shell { width: min(1180px, calc(100% - 48px)); }
.admin-tour-status { display: flex; gap: 14px; margin: 34px 0 0; color: var(--muted); font-size: 12px; }
.admin-tour-status a { color: var(--forest-soft); }
.admin-tours-card { margin-top: 14px; }
.admin-tours-card:first-of-type { margin-top: 44px; }
.admin-tour-form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 20px; padding-top: 28px; }
.admin-tour-field { display: grid; align-content: start; gap: 7px; }
.admin-tour-field-wide { grid-column: span 2; }
.admin-tour-field label { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; color: var(--forest-soft); font-size: 10px; font-weight: 700; letter-spacing: .06em; }
.admin-tour-field label span { color: var(--muted); font-size: 10px; font-weight: 400; letter-spacing: 0; }
.admin-tour-field input, .admin-tour-field textarea, .admin-tour-field select { width: 100%; min-height: 43px; padding: 9px 11px; border: 1px solid var(--line); color: var(--ink); background: var(--sand); outline: 0; font: inherit; font-size: 12px; line-height: 1.7; }
.admin-tour-field textarea { min-height: 130px; resize: vertical; }
.admin-tour-field input[type="checkbox"] { width: 17px; min-height: 17px; accent-color: var(--forest-soft); }
.admin-tour-field input:focus, .admin-tour-field textarea:focus, .admin-tour-field select:focus { border-color: var(--gold); }
.admin-tour-field input:disabled, .admin-tour-field textarea:disabled, .admin-tour-field select:disabled { cursor: wait; opacity: .7; }
.admin-tour-field input[aria-invalid="true"], .admin-tour-field textarea[aria-invalid="true"], .admin-tour-field select[aria-invalid="true"] { border-color: #9a4b3e; }
.admin-tour-field .admin-image-preview { margin-top: 5px; }
.admin-tour-no-image, .admin-tour-empty { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.7; }
.admin-tour-featured-field { align-content: start; }
.admin-checkbox-label { justify-content: flex-start !important; align-items: center !important; gap: 9px !important; color: var(--ink) !important; font-size: 12px !important; font-weight: 400 !important; letter-spacing: 0 !important; }
.admin-tour-list { display: grid; gap: 16px; padding-top: 28px; }
.admin-tour-card { display: grid; gap: 0; padding: 21px; border: 1px solid var(--line); background: var(--sand); }
.admin-tour-card-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; padding-bottom: 16px; border-bottom: 1px solid var(--line); }
.admin-tour-card-heading h3 { margin: 7px 0 0; font-family: Georgia, serif; font-size: 24px; font-weight: 400; }
.admin-tour-card-heading p { margin: 8px 0 0; color: var(--muted); font-size: 11px; overflow-wrap: anywhere; }
.admin-tour-status { flex-shrink: 0; }
.admin-tour-status-draft, .admin-tour-status-published, .admin-tour-status-archived { padding: 5px 8px; border: 1px solid var(--line); color: var(--forest-soft); font-size: 10px; }
.admin-tour-status-published { color: #526b42; }
.admin-tour-status-archived { color: var(--muted); }
.admin-tour-card .admin-tour-form { padding-top: 22px; }
.admin-tour-card .admin-profile-actions { grid-column: span 2; }
.admin-destinations-shell { width: min(1180px, calc(100% - 48px)); }
.admin-destinations-card { margin-top: 14px; }
.admin-destinations-card:first-of-type { margin-top: 44px; }
.admin-destination-new-button { margin-top: 44px; }
.admin-destination-form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 20px; padding-top: 28px; }
.admin-destination-field { display: grid; align-content: start; gap: 7px; }
.admin-destination-field-wide { grid-column: span 2; }
.admin-destination-field label { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; color: var(--forest-soft); font-size: 10px; font-weight: 700; letter-spacing: .06em; }
.admin-destination-field label span { color: var(--muted); font-size: 10px; font-weight: 400; letter-spacing: 0; }
.admin-destination-field input, .admin-destination-field textarea, .admin-destination-field select, .admin-destination-readonly { width: 100%; min-height: 43px; padding: 9px 11px; border: 1px solid var(--line); color: var(--ink); background: var(--sand); outline: 0; font: inherit; font-size: 12px; line-height: 1.7; }
.admin-destination-field textarea { min-height: 130px; resize: vertical; }
.admin-destination-field input[type="checkbox"] { width: 17px; min-height: 17px; accent-color: var(--forest-soft); }
.admin-destination-field input:focus, .admin-destination-field textarea:focus, .admin-destination-field select:focus { border-color: var(--gold); }
.admin-destination-field input:disabled, .admin-destination-field textarea:disabled, .admin-destination-field select:disabled { cursor: wait; opacity: .7; }
.admin-destination-field input[aria-invalid="true"], .admin-destination-field textarea[aria-invalid="true"], .admin-destination-field select[aria-invalid="true"] { border-color: #9a4b3e; }
.admin-destination-readonly { display: flex; align-items: center; color: var(--muted); background: var(--paper); }
.admin-destination-help, .admin-destination-empty { margin: 0; color: var(--muted); font-size: 11px; line-height: 1.6; }
.admin-destination-field .admin-image-preview { margin-top: 5px; }
.admin-destination-checkboxes { align-content: start; }
.admin-destination-checkboxes .admin-checkbox-label { justify-content: flex-start; align-items: center; gap: 9px; color: var(--ink); font-size: 12px; font-weight: 400; letter-spacing: 0; }
.admin-destination-actions { grid-column: span 2; }
.admin-destination-list-controls { display: flex; align-items: center; flex-wrap: wrap; justify-content: flex-end; gap: 10px; }
.admin-destination-list-controls label { color: var(--muted); font-size: 10px; }
.admin-destination-list-controls select { min-height: 34px; padding: 6px 9px; border: 1px solid var(--line); color: var(--ink); background: var(--sand); font: inherit; font-size: 11px; }
.admin-destination-list { display: grid; gap: 16px; padding-top: 28px; }
.admin-destination-summary { display: block; padding: 18px; border: 1px solid var(--line); background: var(--sand); }
.admin-destination-summary-copy { display: grid; align-content: start; gap: 16px; min-width: 0; }
.admin-destination-summary-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--line); }
.admin-destination-summary-heading h3 { margin: 7px 0 0; font-family: Georgia, serif; font-size: 24px; font-weight: 400; }
.admin-destination-summary-heading p { margin: 7px 0 0; overflow-wrap: anywhere; color: var(--muted); font-size: 11px; }
.admin-destination-status { flex-shrink: 0; padding: 5px 8px; border: 1px solid var(--line); color: var(--forest-soft); font-size: 10px; }
.admin-destination-status-published { color: #526b42; }
.admin-destination-status-archived { color: var(--muted); }
.admin-destination-summary-meta { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; margin: 0; }
.admin-destination-summary-meta div { min-width: 0; }
.admin-destination-summary-meta dt { color: var(--muted); font-size: 9px; letter-spacing: .08em; text-transform: uppercase; }
.admin-destination-summary-meta dd { margin: 6px 0 0; overflow-wrap: anywhere; color: var(--ink); font-size: 11px; }
.admin-destination-edit { justify-self: end; }

.admin-theme-shell { width: min(1380px, calc(100% - 48px)); }
.admin-theme-layout { display: grid; grid-template-columns: minmax(300px, .78fr) minmax(0, 1.22fr); gap: 22px; margin-top: 44px; }
.admin-theme-controls, .admin-theme-preview-card { min-width: 0; }
.admin-theme-controls { display: grid; align-content: start; gap: 22px; }
.admin-theme-status { color: var(--muted); font-size: 10px; letter-spacing: .08em; }
.admin-theme-field { display: grid; gap: 8px; color: var(--forest-soft); font-size: 10px; font-weight: 700; letter-spacing: .08em; }
.admin-theme-field select { width: 100%; min-height: 44px; padding: 8px 11px; border: 1px solid var(--line); color: var(--ink); background: var(--sand); outline: 0; font-size: 12px; font-weight: 400; }
.admin-theme-field select:focus { border-color: var(--gold); }
.admin-theme-field select:disabled { cursor: wait; opacity: .65; }
.admin-theme-color-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.admin-theme-color-field { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 8px; padding: 11px; border: 1px solid var(--line); color: var(--forest-soft); font-size: 10px; font-weight: 700; letter-spacing: .06em; }
.admin-theme-color-field input { width: 36px; height: 28px; padding: 0; border: 0; background: transparent; }
.admin-theme-color-field code { grid-column: span 2; color: var(--muted); font-size: 10px; font-weight: 400; letter-spacing: .04em; }
.admin-theme-select-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
.admin-theme-actions { display: flex; flex-wrap: wrap; gap: 10px; padding-top: 18px; border-top: 1px solid var(--line); }
.admin-theme-actions .button { min-width: 120px; }
.admin-theme-note { margin: 0; color: var(--muted); font-size: 11px; line-height: 1.6; }
.admin-theme-preview-card { overflow: hidden; }
.admin-theme-preview-switcher { display: flex; gap: 5px; }
.admin-theme-preview-switcher button { padding: 7px 9px; border: 1px solid var(--line); color: var(--muted); background: var(--sand); font-size: 10px; }
.admin-theme-preview-switcher button.active { border-color: var(--forest); color: var(--white); background: var(--forest); }
.admin-theme-preview-frame { display: flex; justify-content: center; min-height: 650px; padding: 20px; overflow: auto; background: #e8ebe7; }
.admin-theme-preview-site { width: 100%; min-height: 610px; overflow: hidden; background: var(--theme-background); color: var(--theme-primary); font-family: var(--theme-font-family); transition: width .2s ease; }
.admin-theme-preview-mobile .admin-theme-preview-site { width: 390px; }
.admin-theme-preview-nav { display: flex; align-items: center; gap: 16px; min-height: 58px; padding: 0 24px; color: var(--theme-primary); background: var(--theme-background); font-size: 9px; }
.admin-theme-preview-nav strong { margin-right: auto; letter-spacing: .12em; }
.admin-theme-preview-nav .button { min-height: 30px; padding: 0 12px; font-size: 8px; }
.admin-theme-preview-hero { min-height: 270px; padding: 48px 40px; color: var(--white); background: var(--theme-primary); }
.admin-theme-preview-hero .eyebrow { color: var(--theme-accent); }
.admin-theme-preview-hero h3 { max-width: 470px; margin: 0; font-family: Georgia, serif; font-size: clamp(32px, 4vw, 54px); font-weight: 400; letter-spacing: -.04em; line-height: 1; }
.admin-theme-preview-hero p { max-width: 380px; margin: 18px 0 22px; color: rgba(255,255,255,.72); font-size: 11px; line-height: 1.6; }
.admin-theme-preview-hero .button { min-height: 38px; font-size: 9px; }
.admin-theme-preview-section { padding: 34px 40px 45px; background: var(--theme-section-surface); }
.admin-theme-preview-section h4 { margin: 0; font-family: Georgia, serif; font-size: 28px; font-weight: 400; }
.admin-theme-preview-cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-top: 25px; }
.admin-theme-preview-cards article { display: grid; gap: 8px; padding-bottom: 14px; border: var(--theme-card-border); box-shadow: var(--theme-card-shadow); background: var(--theme-background); }
.admin-theme-preview-image { display: block; height: 105px; background: var(--theme-accent); }
.admin-theme-preview-image-alt { background: var(--theme-primary); opacity: .8; }
.admin-theme-preview-cards strong, .admin-theme-preview-cards small { padding: 0 12px; }
.admin-theme-preview-cards strong { font-family: Georgia, serif; font-size: 17px; font-weight: 400; }
.admin-theme-preview-cards small { color: var(--muted); font-size: 9px; }

@media (max-width: 760px) {
  .admin-topbar { min-height: 72px; padding: 0 20px; }
  .admin-topbar-actions { gap: 10px; }
  .admin-tenant-chip { display: none; }
  .admin-shell { width: calc(100% - 40px); padding: 48px 0 64px; }
  .admin-heading { align-items: flex-start; flex-direction: column; }
  .admin-heading-actions { width: 100%; justify-content: flex-start; }
  .admin-heading-actions .button { width: 100%; }
  .admin-site-link { width: 100%; }
  .admin-metrics { grid-template-columns: repeat(2, 1fr); margin-top: 40px; }
  .admin-grid { grid-template-columns: 1fr; }
  .admin-card-wide { grid-column: auto; }
  .admin-description-grid { grid-template-columns: 1fr; gap: 0; }
  .admin-card { padding: 23px 19px; }
  .admin-card-heading { align-items: flex-start; flex-direction: column-reverse; gap: 9px; }
  .admin-card-heading-links { justify-content: flex-start; }
  .admin-topbar-link { display: none; }
  .admin-inquiry-toolbar, .admin-inquiry-status-editor { align-items: flex-start; flex-direction: column; }
  .admin-inquiry-pagination { align-items: flex-start; flex-direction: column; }
  .admin-inquiry-detail-grid { grid-template-columns: 1fr; }
  .admin-profile-shell { width: calc(100% - 40px); }
  .admin-profile-card { margin-top: 32px; }
  .admin-profile-field-grid { grid-template-columns: 1fr; }
  .admin-profile-field-wide { grid-column: auto; }
  .admin-profile-field label { align-items: flex-start; flex-direction: column; gap: 4px; }
  .admin-profile-actions { align-items: stretch; flex-direction: column; }
  .admin-profile-actions .button { width: 100%; }
  .admin-login-card { padding: 34px 24px; }
  .admin-login-brand { margin-bottom: 50px; }
  .admin-images-shell { width: calc(100% - 40px); }
  .admin-images-section:first-of-type { margin-top: 32px; }
  .admin-image-card-grid { grid-template-columns: 1fr; }
  .admin-image-card-heading { flex-direction: column; }
  .admin-image-card-label { max-width: 100%; text-align: left; }
  .admin-image-preview img { height: 190px; }
  .admin-contacts-shell { width: calc(100% - 40px); }
  .admin-contacts-card { margin-top: 32px; }
  .admin-contact-card { padding: 18px; }
  .admin-contact-card-heading { flex-direction: column; }
  .admin-contact-fields { grid-template-columns: 1fr; }
  .admin-contact-field:nth-child(5) { grid-column: auto; }
  .admin-tours-shell { width: calc(100% - 40px); }
  .admin-tours-card:first-of-type { margin-top: 32px; }
  .admin-tour-form { grid-template-columns: 1fr; }
  .admin-tour-field-wide, .admin-tour-card .admin-profile-actions { grid-column: auto; }
  .admin-tour-card { padding: 18px; }
  .admin-tour-card-heading { flex-direction: column; }
  .admin-destinations-shell { width: calc(100% - 40px); }
  .admin-destinations-card:first-of-type { margin-top: 32px; }
  .admin-destination-new-button { width: 100%; margin-top: 32px; }
  .admin-destination-form { grid-template-columns: 1fr; }
  .admin-destination-field-wide, .admin-destination-actions { grid-column: auto; }
  .admin-destination-list-controls { justify-content: flex-start; }
  .admin-destination-summary { padding: 16px; }
  .admin-destination-summary-heading { flex-direction: column; }
  .admin-destination-summary-meta { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .admin-theme-shell { width: calc(100% - 40px); }
  .admin-theme-layout { grid-template-columns: 1fr; margin-top: 32px; }
  .admin-theme-select-grid { grid-template-columns: 1fr; }
  .admin-theme-preview-frame { min-height: 560px; padding: 12px; }
  .admin-theme-preview-desktop .admin-theme-preview-site { min-width: 720px; }
  .admin-theme-preview-mobile .admin-theme-preview-site { width: 100%; }
}
