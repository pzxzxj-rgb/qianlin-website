{
  "name": "qianlin-travel-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/image-management.test.mjs tests/contact-management.test.mjs tests/tour-management.test.mjs tests/destination-management.test.mjs tests/inquiry-management.test.mjs tests/planner-data.test.mjs tests/tenant-isolation.test.mjs tests/turnstile.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc --persist-to .wrangler/state",
    "db:check:local": "node scripts/check-local-d1.mjs",
    "db:inquiries:local": "node scripts/list-inquiries-local.mjs",
    "db:reset:local": "node scripts/reset-local-d1.mjs",
    "test:integration:local": "node scripts/test-local-d1.mjs && node scripts/test-local-http.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.0",
    "@cloudflare/workers-types": "5.20260804.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.1",
    "wrangler": "4.119.0"
  },
  "type": "module"
}
