NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 本地没有配置时 Turnstile 会明确处于关闭状态。生产环境必须填写真实配置。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 行程规划默认使用本地规则，外部 provider 仅保留后续接入位置。
ITINERARY_PROVIDER=local
ITINERARY_API_BASE_URL=
ITINERARY_API_KEY=
ITINERARY_API_MODEL=

# 管理员登录账号，仅用于本地或正式环境配置，不要提交真实密码。
ADMIN_USERNAME=
# PBKDF2-SHA256 格式：pbkdf2-sha256$迭代次数$Base64URL盐$Base64URL哈希
ADMIN_PASSWORD_HASH=
# 用于签发管理员 HttpOnly session Cookie 的随机密钥。
ADMIN_SESSION_SECRET=

# 3G 通用咨询同步：默认关闭 ERP。Mock 仅允许本地/自动化测试，生产环境会拒绝 Mock。
ERP_PROVIDER=disabled
# 真实智旅 Provider 暂未接入；不要把 Token、用户名、密码或租户编号放进 NEXT_PUBLIC_ 变量。
ERP_API_URL=
ERP_API_TOKEN=
# 不要提交 .env.local 或 .dev.vars，也不要把任何 ERP Secret 写入浏览器变量。
